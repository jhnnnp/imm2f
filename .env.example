# Copy to .env.local after creating a Supabase project.
# Dashboard > Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
SUPABASE_SECRET_KEY=

# Optional alias if the project still shows the legacy anon key name.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Auth settings in Supabase (signup respects the project's email confirmation policy):
# 1. Authentication > Providers > Email: enable Email
# 2. Authentication > URL Configuration: set the production Site URL and allow
#    https://YOUR_DOMAIN/auth/callback (plus the local callback while developing).
# 3. Set NEXT_PUBLIC_SITE_URL to that HTTPS origin for confirmation emails.
# 4. Keep SUPABASE_SECRET_KEY server-only; server features use it when configured.
# 5. On a new project, apply ALL supabase/migrations/*.sql in filename order.
#    On an existing project, inspect migration history and apply only missing ones.
#    Back up existing data before any migration; some historical files remove demo data.
#    The migrations include atomic plan saves, private memory-photos storage,
#    wall-board Realtime, coordinate persistence, taste data, and session snapshots.
# See docs/operations.md for the production startup and two-user verification flow.

# Signup confirmation origin. Use your HTTPS domain in production.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# Kakao Developers > 앱 > 플랫폼 키. Server only. Never expose REST key to the browser.
KAKAO_REST_API_KEY=
KAKAO_JAVASCRIPT_KEY=
KAKAO_NATIVE_APP_KEY=

# OpenAI. Server only. Reasons over the conversation and verified venue records
# to select places, explain tradeoffs, and design feasible itineraries.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
# Separate public-fact lookup model; judgments still use OPENAI_MODEL.
# Defaults to gpt-4.1-mini to keep bounded search calls responsive.
OPENAI_SEARCH_MODEL=
# Shared AI course-design deadline (milliseconds, 5000..60000).
# Structure and actual-route verification share at most one model repair.
DATE_ENGINE_DESIGN_TIMEOUT_MS=45000

# data.go.kr 한국관광공사 KorService2. Server only.
TOUR_API_SERVICE_KEY=
