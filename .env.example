# Copy to .env.local after creating a Supabase project.
# Dashboard > Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
SUPABASE_SECRET_KEY=

# Optional alias if the project still shows the legacy anon key name.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Auth settings in Supabase (accounts are confirmed immediately by the server):
# 1. Authentication > Providers > Email: enable Email
# 2. Set SUPABASE_SECRET_KEY above; signup will fail closed without it.
# 3. Run these SQL files in the SQL editor:
#    supabase/migrations/20260916000000_init_couple_places.sql
#    supabase/migrations/20260916010000_places_kakao_fields.sql
#    supabase/migrations/20260916020000_places_tourapi.sql
#    supabase/migrations/20260916030000_plans_and_categories.sql
#    supabase/migrations/20260916040000_collaboration.sql
#    supabase/migrations/20260916050000_memories.sql
#    supabase/migrations/20260916060000_days_lists_storage.sql
#    supabase/migrations/20260916070000_atomic_plan_save.sql
#    supabase/migrations/20260916080000_remove_demo_places.sql
#    supabase/migrations/20260916090000_private_photo_metadata.sql
#    supabase/migrations/20260917000000_couple_insights.sql
#    supabase/migrations/20260917120000_activities_delete.sql
#    supabase/migrations/20260918130000_activities_update.sql
#    supabase/migrations/20260918020000_date_drafts.sql
#    supabase/migrations/20260918030000_plan_item_coordinates.sql
#    supabase/migrations/20260918040000_reject_own_invite.sql
#    supabase/migrations/20260918050000_leave_couple_and_clear_demo.sql
#    supabase/migrations/20260918060000_taste_profiles.sql
# Storage: memory-photos bucket is created by the last migration.

# Optional. Used as emailRedirectTo origin during signup.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# Kakao Developers > 앱 > 플랫폼 키. Server only. Never expose REST key to the browser.
KAKAO_REST_API_KEY=
KAKAO_JAVASCRIPT_KEY=
KAKAO_NATIVE_APP_KEY=

# OpenAI. Server only. Used to rank Kakao/TourAPI candidates, generate A/B/C plans,
# propose plan edits, and summarize couple taste — never to invent places.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

# data.go.kr 한국관광공사 KorService2. Server only.
TOUR_API_SERVICE_KEY=
